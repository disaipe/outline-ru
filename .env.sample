# Russian language by default for new users and anonymous visitors.
# Users can still switch in Settings → Preferences.
DEFAULT_LANGUAGE=ru_RU

# --- translation backend (used by scripts/translate-missing.ts) --------------
# Pick one provider. If both keys are set, TRANSLATION_PROVIDER decides;
# without it OpenAI wins, then Anthropic.
#
# TRANSLATION_PROVIDER=openai|anthropic    # optional explicit choice
#
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini                 # optional, default gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1  # optional, for OpenAI-compatible endpoints
#
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001  # optional, default claude-haiku-4-5
#
# TRANSLATE_BATCH_SIZE=40                  # optional, keys per API call
# -----------------------------------------------------------------------------

# Everything below is pass-through to the upstream Outline build.
# Refer to .build/outline/.env.sample after running scripts/build.sh for the
# full list of supported variables (SECRET_KEY, DATABASE_URL, REDIS_URL, ...).
